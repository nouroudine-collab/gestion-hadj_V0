/* sidebar.qss - COMPATIBLE VERSION */

#sideBar {
    background-color: #f5f7fb;
}

/* Toggle button - use object name */
#toggleButton {
    background-color: #1A4ABE;
    color: #1A4ABE;
    border: none;
    border-radius: 8px;
    font-size: 20px;
    font-weight: bold;
    margin: 12px 20px;
    padding: 8px;
}

#toggleButton:hover {
    background-color: #1A4ABE;
}

#toggleButton:pressed {
    background-color: #2c3e50;
}

/* Navigation buttons */
QPushButton#navButton {
    background-color: transparent;
    color: black;
    border: none;
    border-radius: 8px;
    padding: 12px 16px;
    text-align: left;
    font-size: 14px;
    margin: 2px 5px;
}

QPushButton#navButton:hover {
    background-color: #1A4ABE;
    color: #ecf0f1;
}

QPushButton#navButton:checked {
    background-color: #1A4ABE;
    color: white;
    font-weight: bold;
}

QPushButton#navButton:checked:hover {
    background-color: #2980b9;
}